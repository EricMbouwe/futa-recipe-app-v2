{
  "/recipes/search": {
    "get": {
      "responses": {
        "200": {
          "type": "object",
          "required": [
            "recipes",
            "page",
            "total_count"
          ],
          "properties": {
            "total_count": {
              "type": "integer",
              "format": "int64",
              "minimum": -9223372036854776000,
              "maximum": 9223372036854776000
            },
            "page": {
              "type": "integer",
              "format": "int64",
              "minimum": -9223372036854776000,
              "maximum": 9223372036854776000
            },
            "recipes": {
              "type": "array",
              "items": {
                "type": "object",
                "required": [
                  "id",
                  "name",
                  "duration_in_mins",
                  "category",
                  "result_image_url",
                  "ingredients"
                ],
                "properties": {
                  "id": {
                    "type": "string",
                    "format": "uuid",
                    "description": "Random and Unique identifier for our entities. (uuid v4)"
                  },
                  "name": {
                    "type": "string"
                  },
                  "duration_in_mins": {
                    "type": "integer",
                    "format": "int64",
                    "minimum": -9223372036854776000,
                    "maximum": 9223372036854776000
                  },
                  "category": {
                    "type": "string"
                  },
                  "result_image_url": {
                    "type": "string"
                  },
                  "ingredients": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          },
          "$schema": "http://json-schema.org/draft-04/schema#"
        },
        "500": {
          "type": "object",
          "properties": {
            "error": {
              "type": "object",
              "required": [
                "id",
                "http_code",
                "developer_message",
                "details"
              ],
              "properties": {
                "id": {
                  "type": "string",
                  "enum": [
                    "generic"
                  ]
                },
                "http_code": {
                  "type": "integer",
                  "enum": [
                    500
                  ]
                },
                "developer_message": {
                  "type": "string",
                  "enum": [
                    "Generic, no handled runtime error. Contact with the backend team"
                  ]
                },
                "details": {
                  "type": "object",
                  "description": "Object with details about the error"
                }
              }
            }
          },
          "required": [
            "error"
          ],
          "$schema": "http://json-schema.org/draft-04/schema#"
        }
      }
    }
  }
}
